# =========================================================
# Repomix ignore patterns
#
# Repomix ya respeta .gitignore por defecto y excluye el
# contenido de los binarios (lista sus paths en la seccion
# de estructura, pero no empaqueta su contenido). Este
# archivo solo anade lo que NO cubre .gitignore y que es
# especifico del pack para AI:
#
#   - tests/                  decision de proyecto
#   - _source/                volcados TIA (.s7dcl/.s7res)
#   - *.bak                   backups accidentales en raiz
#   - *.pyd                   binarios .NET nativos de Siemens
#   - repomix-output*.xml     auto-excluir la propia salida
# =========================================================

# Tests: se ejecutan con pytest, no aportan al pack de AI
tests/

# Volcados exportados de TIA Portal (fuentes S7, no son
# codigo del proyecto). Tambien deberian ir al .gitignore.
_source/

# Backups accidentales en raiz (scripts de debug viejos)
*.bak

# Binarios .NET nativos de Siemens (se stagean en tempdir
# durante el build, nunca deben acabar en el repo)
*.pyd

# Auto-excluir la salida del propio repomix
repomix-output*.xml
