/**
 * Componente ProgressOverlay.
 *
 * Overlay NO-MODAL (confirmado por el usuario) que muestra el avance
 * de las operaciones largas del backend (Generar Previsión, Aplicar
 * Cambios, Cargar Excel, etc.). Se renderiza encima de la
 * ``<ConsolaLogs>`` y nunca tapa el contenido crítico.
 *
 * Fuente de verdad: ``store.progress`` (espejo reactivo del
 * ``ProgressTracker`` backend, alimentado por el polling 500 ms de
 * ``main.js``). El componente NO hace fetches: solo consume el store.
 *
 * Estados visuales:
 *   * ``active=true`` con stages corriendo → overlay azul con ⏳.
 *   * ``active=false`` + ``error`` no nulo → overlay rojo 5s, auto-clear.
 *   * ``active=false`` + stages no vacíos (sin error) → overlay verde
 *     "Completado" 3s, auto-clear.
 *   * ``active=false`` + stages vacíos + sin error → no se muestra.
 *
 * Acciones del operario:
 *   * Botón "Ocultar / Mostrar" (toggle local sin tocar backend).
 *   * Botón "Cerrar" (solo en estados terminales): dispara
 *     ``apiClearProgress`` + auto-clear inmediato.
 *
 * NO hay botón "Cancelar": la transacción COM es atómica y matarla
 * a medias puede dejar TIA Portal inconsistente. El operario espera.
 *
 * Tema: Industrial Claro. Solo tokens semánticos del theme
 * (``bg-surface*``, ``text-ink*``, ``bg-accent``, ``border-line``,
 * ``text-green-600``, ``text-red-600``, ``text-amber-600``).
 *
 * IMPORTANTE sobre templates Vue: el compilador en runtime de
 * ``vue.esm-browser.prod.js`` NO acepta string literals multi-línea
 * dentro de arrays de ``:class``. Cada literal va en una sola línea.
 */
import { computed, onBeforeUnmount, onMounted, ref, watch } from "https://unpkg.com/vue@3/dist/vue.esm-browser.prod.js";
import { store, pushLog } from "../store.js";
import { apiClearProgress } from "../api.js";

/**
 * Icono + clase por status de stage. Mantenido como objeto simple
 * (no reactividad): los stages vienen de ``store.progress`` ya
 * reactivo.
 */
const STAGE_ICON = {
    pending:  { icon: "○", cls: "text-ink-muted" },
    running:  { icon: "⏳", cls: "text-accent" },
    done:     { icon: "✓", cls: "text-green-600" },
    error:    { icon: "✗", cls: "text-red-600" },
};

const AUTO_CLOSE_SUCCESS_MS = 3500;   // 3.5 s tras éxito
const AUTO_CLOSE_ERROR_MS = 5000;     // 5 s tras error

export default {
    name: "ProgressOverlay",
    setup() {
        /** Flag local: ¿el operario ha ocultado manualmente el overlay? */
        const hidden = ref(false);

        /**
         * DEMO MODE: ``?demo=1`` en la URL activa una simulación
         * visual. NO se activa por defecto (porque pisaría el
         * polling real). Solo usar para QA visual.
         */
        const isDemoMode = new URLSearchParams(window.location.search)
            .get("demo") === "1";

        if (isDemoMode) {
            // Simulación de "Generar Previsión" con 4 stages reales.
            store.progress = {
                active: true,
                operation: "preview",
                label: "Generando previsión para PLC_DEMO (demo)",
                current: 0,
                total: 4,
                percent: 0,
                stages: [
                    { id: "export_tags", label: "Export tags", status: "running", detail: "Iniciando export bulk...", started_at: new Date().toISOString(), finished_at: null },
                    { id: "compute_devices", label: "Compute devices", status: "pending", detail: null, started_at: null, finished_at: null },
                    { id: "compute_nmax", label: "Compute nmax", status: "pending", detail: null, started_at: null, finished_at: null },
                    { id: "build_response", label: "Build response", status: "pending", detail: null, started_at: null, finished_at: null },
                ],
                started_at: new Date().toISOString(),
                finished_at: null,
                error: null,
            };
            // Avanza los stages cada 800 ms para que el operario vea
            // las transiciones de iconos y la barra de progreso.
            let i = 0;
            const tick = () => {
                if (i >= store.progress.stages.length) {
                    store.progress.active = false;
                    store.progress.finished_at = new Date().toISOString();
                    pushLog("Demo ProgressOverlay: simulación completada", "info");
                    return;
                }
                store.progress.current = i;
                store.progress.stages[i].status = "running";
                store.progress.stages[i].started_at = new Date().toISOString();
                setTimeout(() => {
                    store.progress.stages[i].status = "done";
                    store.progress.stages[i].finished_at = new Date().toISOString();
                    store.progress.stages[i].detail = `OK (${i + 1}/${store.progress.stages.length})`;
                    i += 1;
                    setTimeout(tick, 400);
                }, 600);
            };
            setTimeout(tick, 600);
        }

        /** Timer para auto-close. Se cancela si llega un nuevo estado. */
        let autoCloseTimer = null;

        function clearAutoClose() {
            if (autoCloseTimer !== null) {
                clearTimeout(autoCloseTimer);
                autoCloseTimer = null;
            }
        }

        /**
         * ¿El overlay debe mostrarse?
         *
         * Reglas:
         *   * Si operario lo ocultó y la operación sigue activa, mantenemos
         *     el flag pero el componente no se renderiza (v-if fuera).
         *   * Si operario lo ocultó y termina la operación, reseteamos
         *     ``hidden`` para la próxima.
         *   * Si ``active=false`` y stages vacíos y sin error, no mostrar.
         */
        const shouldShow = computed(() => {
            const p = store.progress;
            if (hidden.value) return false;
            if (p.active) return true;
            if (p.error) return true;
            if (Array.isArray(p.stages) && p.stages.length > 0) return true;
            return false;
        });

        /** Modo visual del overlay según el estado. */
        const mode = computed(() => {
            const p = store.progress;
            if (p.active) return "running";
            if (p.error) return "error";
            if (Array.isArray(p.stages) && p.stages.length > 0) return "success";
            return "idle";
        });

        /** Color del header según modo. */
        const headerCls = computed(() => {
            switch (mode.value) {
                case "running": return "bg-accent text-ink-inverse";
                case "error":   return "bg-red-600 text-ink-inverse";
                case "success": return "bg-green-600 text-ink-inverse";
                default:        return "bg-surface-sunken text-ink-muted";
            }
        });

        /** Título del header. */
        const title = computed(() => {
            const p = store.progress;
            if (mode.value === "error") {
                return `✗ Error: ${p.label || "operación"}`;
            }
            if (mode.value === "success") {
                return `✓ Completado: ${p.label || "operación"}`;
            }
            if (mode.value === "running") {
                return `⏳ ${p.label || "operación en curso..."}`;
            }
            return "";
        });

        /** Subtítulo (status textual). */
        const subtitle = computed(() => {
            const p = store.progress;
            if (mode.value === "running") {
                return `Paso ${p.current}/${p.total} — ${p.percent}%`;
            }
            if (mode.value === "error") {
                return p.error || "Operación fallida";
            }
            if (mode.value === "success") {
                const dur = p.started_at && p.finished_at
                    ? `${calcDurationSec(p.started_at, p.finished_at)} s`
                    : "";
                return dur ? `Duración: ${dur}` : "Todo en orden";
            }
            return "";
        });

        /** Duración de un stage individual (para mostrar en cada fila). */
        function stageDurationSec(stage) {
            if (!stage.started_at || !stage.finished_at) return null;
            return calcDurationSec(stage.started_at, stage.finished_at);
        }

        function calcDurationSec(startIso, endIso) {
            const s = new Date(startIso).getTime();
            const e = new Date(endIso).getTime();
            if (isNaN(s) || isNaN(e)) return null;
            return ((e - s) / 1000).toFixed(1);
        }

        /**
         * Watcher: cuando el estado pasa de "running" a terminal
         * (success/error), programa el auto-close. Si vuelve a
         * "running" antes de expirar, cancela el timer.
         */
        watch(
            () => store.progress.active,
            (newActive, oldActive) => {
                clearAutoClose();
                if (oldActive && !newActive) {
                    // Acaba de terminar. Auto-close después del delay.
                    const delay = store.progress.error
                        ? AUTO_CLOSE_ERROR_MS
                        : AUTO_CLOSE_SUCCESS_MS;
                    autoCloseTimer = setTimeout(() => {
                        autoCloseTimer = null;
                        // Llamar al backend para limpiar (idempotente).
                        apiClearProgress().then(() => {
                            // Reset local. El polling siguiente lo reflejará
                            // pero limpiamos ya para no parpadear.
                            store.progress = {
                                active: false,
                                operation: null,
                                label: null,
                                current: 0,
                                total: 0,
                                percent: 0,
                                stages: [],
                                started_at: null,
                                finished_at: null,
                                error: null,
                            };
                            hidden.value = false;
                        }).catch(() => {
                            // Si falla el clear, no importa: el polling
                            // recuperará el estado.
                        });
                    }, delay);
                } else if (newActive) {
                    // Nueva operación. Resetear "hidden" para mostrarla.
                    hidden.value = false;
                }
            },
        );

        /** Toggle mostrar/ocultar (solo afecta al componente, no al backend). */
        function toggleHidden() {
            hidden.value = !hidden.value;
        }

        /** Cerrar manualmente: dispara clear inmediato. */
        function closeNow() {
            clearAutoClose();
            apiClearProgress().then(() => {
                store.progress = {
                    active: false,
                    operation: null,
                    label: null,
                    current: 0,
                    total: 0,
                    percent: 0,
                    stages: [],
                    started_at: null,
                    finished_at: null,
                    error: null,
                };
                hidden.value = false;
            });
        }

        onMounted(() => {
            pushLog("ProgressOverlay: montado", "info");
        });

        onBeforeUnmount(() => {
            clearAutoClose();
        });

        return {
            shouldShow,
            mode,
            headerCls,
            title,
            subtitle,
            store,
            stageMeta: STAGE_ICON,
            stageDurationSec,
            toggleHidden,
            closeNow,
        };
    },
    template: /* html */ `
        <section v-if="shouldShow"
            data-testid="progress-overlay"
            :data-mode="mode"
            class="fixed bottom-12 right-4 w-[28rem] max-w-[calc(100vw-2rem)] bg-surface-raised border border-line rounded-lg shadow-lg z-50 flex flex-col overflow-hidden">
            <!-- Header coloreado según modo -->
            <header :class="['flex justify-between items-center px-3 py-2 text-xs font-bold', headerCls]">
                <span class="truncate">{{ title }}</span>
                <div class="flex gap-1 ml-2">
                    <button @click="toggleHidden"
                        class="text-[10px] px-1.5 py-0.5 rounded bg-black/20 hover:bg-black/30"
                        :title="store.progress.active ? 'Ocultar (sin afectar backend)' : 'Cerrar'"
                        data-testid="progress-toggle">
                        {{ store.progress.active ? "Ocultar" : "Mostrar" }}
                    </button>
                    <button v-if="!store.progress.active"
                        @click="closeNow"
                        class="text-[10px] px-1.5 py-0.5 rounded bg-black/20 hover:bg-black/30"
                        title="Cerrar definitivamente"
                        data-testid="progress-close">
                        Cerrar
                    </button>
                </div>
            </header>

            <!-- Subtítulo (status textual) -->
            <div class="px-3 py-1.5 text-[10px] text-ink-muted bg-surface-sunken border-b border-line">
                {{ subtitle }}
            </div>

            <!-- Barra de progreso global -->
            <div class="h-1.5 bg-surface-sunken">
                <div class="h-full transition-all duration-300"
                    :class="mode === 'error' ? 'bg-red-600' : mode === 'success' ? 'bg-green-600' : 'bg-accent'"
                    :style="{ width: store.progress.percent + '%' }">
                </div>
            </div>

            <!-- Lista de stages -->
            <ol class="flex-1 overflow-y-auto max-h-64 py-1.5 px-3 text-xs"
                data-testid="progress-stages">
                <li v-for="(stage, idx) in store.progress.stages"
                    :key="stage.id"
                    :class="['flex justify-between items-baseline py-0.5',
                             stage.status === 'running' ? 'bg-accent-subtle rounded px-1' : '']">
                    <span class="flex items-baseline gap-1.5 min-w-0">
                        <span :class="['w-3 text-center', stageMeta[stage.status]?.cls || 'text-ink-muted']">
                            {{ stageMeta[stage.status]?.icon || "?" }}
                        </span>
                        <span class="text-ink-muted w-4 text-right">{{ idx + 1 }}.</span>
                        <span class="truncate text-ink"
                            :class="stage.status === 'pending' ? 'text-ink-muted' : ''">
                            {{ stage.label }}
                        </span>
                        <span v-if="stage.detail" class="text-ink-muted italic text-[10px] truncate">
                            — {{ stage.detail }}
                        </span>
                    </span>
                    <span class="text-[10px] text-ink-muted ml-2 flex-shrink-0">
                        <span v-if="stage.status === 'running'">...</span>
                        <span v-else-if="stageDurationSec(stage)">{{ stageDurationSec(stage) }}s</span>
                    </span>
                </li>
            </ol>
        </section>
    `,
};
