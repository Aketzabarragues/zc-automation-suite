/* ===========================================================================
 *  input.css — Fuente del CSS de la SPA ZC Automation Suite.
 * ---------------------------------------------------------------------------
 *  Compilado offline por el binario `tailwindcss-extra` (Tailwind v4 +
 *  daisyUI) a `interfaces/web_server/static/styles.css`, que se sirve
 *  como recurso local desde el FastAPI (sin CDN).
 *
 *  Tema Industrial Claro:
 *    • Superficies neutrales (gris muy claro / blanco).
 *    • Acento azul marino Siemens (`rgb(0 52 102)`).
 *    • La Consola de Logs conserva su estética de terminal oscura
 *      mediante clases literales dentro de su propio componente
 *      (`ConsolaLogs.js`); los tokens semánticos de este tema solo
 *      aplican a Sidebar / Inspector / Sync.
 *
 *  NOTA: daisyUI queda explícitamente fuera del pipeline (deuda
 *  técnica erradicada en este ticket). Si más adelante se
 *  reintroduce, evaluar antes el impacto en el bundle.
 * =========================================================================== */

@import "tailwindcss";

/* ── Paths de escaneo de clases ────────────────────────────────────────
 * Es esencial incluir `static/js//.js`: las plantillas Vue viven
 * como template strings dentro de los componentes ESM, por lo que
 * Tailwind NO las detecta si sólo escanea HTML. */
@source "../index.html";
@source "../js/**/*.js";

/* ── Tokens semánticos del tema ──────────────────────────────────────── */
@theme {
  /* Superficies */
  --color-surface:         #f3f4f6;  /* fondo general de la app */
  --color-surface-raised:  #ffffff;  /* paneles, tarjetas, tablas */
  --color-surface-sunken:  #e5e7eb;  /* inputs, filas alternas, botones secundarios */

  /* Bordes */
  --color-line:            #d1d5db;
  --color-line-strong:     #9ca3af;  /* inputs en foco, divisores con énfasis */

  /* Texto */
  --color-ink:             #1f2937;  /* texto principal */
  --color-ink-muted:       #6b7280;  /* texto secundario, etiquetas */
  --color-ink-inverse:     #ffffff;  /* texto sobre el acento */

  /* Acento (Azul Marino Siemens / Industrial) */
  --color-accent:          rgb(0 52 102);
  --color-accent-hover:    rgb(0 40 79);
  --color-accent-subtle:   rgb(230 237 245);
}
