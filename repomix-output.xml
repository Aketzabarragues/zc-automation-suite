<file path="application/use_cases/sync_constants_from_excel.py">
"""Caso de Uso: sincronización desde Excel (AppState) con patrón preview/apply.

Orquestador de ALTO NIVEL que combina:
  - ``AppState`` (con el Excel ya parseado por ``tia_sync_dispositivos_dimensions_from_excel``).
  - ``TIAProcessGateway`` (para leer/escribir el PLC vía COM).
  - ``ConfigManager`` (para resolver ``hw_type → tag_table``).
  - ``SyncConstantsUnifiedUseCase`` (orquestador de bajo nivel con
    métodos ``preview()`` y ``execute()``).

Restricción arquitectónica: este módulo es OFFLINE en cuanto a TIA; solo
interactúa con el PLC vía ``TIAProcessGateway`` (que delega al worker OT).

Flujo end-to-end
----------------
1. **PRECONDICIÓN**: el operario debe haber cargado el Excel al ``AppState``
   mediante ``tia_sync_dispositivos_dimensions_from_excel``.
2. ``preview(plc_name)``: lee PLC actual + diff contra AppState. **NO** toca TIA.
3. ``execute(plc_name)``: lee PLC actual + diff + transacción COM unificada.

Patrón dry-run / preview
------------------------
``preview()`` es CRÍTICO para UX: el operario quiere ver qué cambios se
aplicarán ANTES de comprometerse. Es la versión moderna del antiguo
``generar_prevision(plc_name)`` del legacy, pero extendida a N_MAX + todas
las tablas de dispositivos a través del flujo unificado.
"""
from __future__ import annotations

import logging
from typing import Any

from application.state import AppState
from application.use_cases.sync_constants_unified import SyncConstantsUnifiedUseCase
from infrastructure.config_manager import ConfigManager
from infrastructure.gateway import TIAProcessGateway


_logger: logging.Logger = logging.getLogger(
    f"{__name__}.SyncConstantsFromExcelUseCase"
)


# Mapeo de hw_type lógico (config.json) al nombre del atributo en AppState.
# Centraliza la convención para evitar hardcodear en cada llamada.
_APP_STATE_ATTRS: dict[str, str] = {
    "ed":    "dispositivos_ed",
    "ea":    "dispositivos_ea",
    "sa":    "dispositivos_sa",
    "v":     "dispositivos_v",
    "m":     "dispositivos_m",
    "m_vf":  "dispositivos_m_vf",
}


class SyncConstantsFromExcelUseCase:
    """Orquestador de alto nivel: Excel (AppState) ↔ TIA Portal.

    Es un **orquestador de orquestador**: no contiene lógica de cálculo de
    diffs ni de modificación XML/COM. Solo:
      1. Valida que ``AppState`` tenga datos del Excel.
      2. Lee el estado actual del PLC vía ``gateway.get_user_constants()``.
      3. Construye el ``desired_state`` desde ``AppState``.
      4. Delega al ``SyncConstantsUnifiedUseCase`` (preview o apply).

    Inyección de dependencias (clean architecture)
    ----------------------------------------------
    Recibe ``gateway``, ``config_manager`` y ``app_state`` por constructor.
    NO usa Singleton/global: esto permite testing con mocks.
    """

    def __init__(
        self,
        gateway: TIAProcessGateway,
        config_manager: ConfigManager,
        app_state: AppState,
    ) -> None:
        """Inicializa el caso de uso con sus dependencias.

        Args:
            gateway:        Gateway asíncrono hacia el worker OT.
            config_manager: Gestor de configuración con el mapeo
                ``hw_type → tag_table``.
            app_state:      Singleton con el Excel ya parseado.
        """
        self._gateway = gateway
        self._config = config_manager
        self._state = app_state
        self._sync_unified = SyncConstantsUnifiedUseCase(
            gateway=gateway, config_manager=config_manager
        )

    # ── API pública ─────────────────────────────────────────────────────
    async def preview(self, plc_name: str) -> dict[str, Any]:
        """Calcula el diff entre el Excel (AppState) y el PLC. NO toca TIA.

        Args:
            plc_name: Nombre del PLC destino.

        Returns:
            ``dict`` con:
              - ``success``: ``True`` siempre (la operación no muta TIA).
              - ``preview``: ``True`` (marca de dry-run).
              - ``nmax_ops``: lista de operaciones N_MAX pendientes.
              - ``device_diffs``: ``{hw_type: [ops]}``.
              - ``summary``: ``{n_max_updates, device_renames, total_ops, has_changes}``.
              - ``warnings``: lista de advertencias (ej. AppState vacío).
              - ``has_app_state``: ``True`` si AppState tiene datos.
        """
        warnings = self._check_app_state()

        # 1. Leer estado actual del PLC.
        try:
            states = await self._read_plc_states(plc_name)
        except Exception as e:
            _logger.error(f"Error leyendo estado del PLC '{plc_name}': {e}")
            raise

        # 2. Construir desired desde AppState.
        nmax_desired = self._build_nmax_desired_from_appstate()
        device_states_by_type = self._build_device_states_from_appstate(
            states.get("device_current", {})
        )

        # 3. Delegar al orquestador unificado en modo preview.
        result = await self._sync_unified.preview(
            plc_name=plc_name,
            nmax_current_state=states["nmax_current"],
            nmax_desired_state=nmax_desired,
            device_states_by_type=device_states_by_type,
        )

        # 4. Empaquetar respuesta con metadatos del AppState.
        result.update(
            {
                "success": True,
                "preview": True,
                "warnings": warnings,
                "has_app_state": not warnings,
            }
        )
        return result

    async def execute(self, plc_name: str) -> dict[str, Any]:
        """Calcula el diff Y aplica la transacción COM unificada.

        Args:
            plc_name: Nombre del PLC destino.

        Returns:
            ``dict`` con:
              - ``success``: ``True`` si la transacción fue exitosa.
              - ``applied``: ``True`` (marca de apply).
              - ``operations_executed``: número de operaciones aplicadas.
              - ``details``: detalles devueltos por el worker.
              - ``warnings``: lista de advertencias (ej. AppState vacío).
        """
        warnings = self._check_app_state()

        # 1. Leer estado actual del PLC.
        states = await self._read_plc_states(plc_name)

        # 2. Construir desired desde AppState.
        nmax_desired = self._build_nmax_desired_from_appstate()
        device_states_by_type = self._build_device_states_from_appstate(
            states.get("device_current", {})
        )

        # 3. Delegar al orquestador unificado en modo apply.
        result = await self._sync_unified.execute(
            plc_name=plc_name,
            nmax_current_state=states["nmax_current"],
            nmax_desired_state=nmax_desired,
            device_states_by_type=device_states_by_type,
        )

        result.update(
            {
                "applied": True,
                "warnings": warnings,
            }
        )
        return result

    # ── Helpers privados ───────────────────────────────────────────────
    def _check_app_state(self) -> list[str]:
        """Verifica que ``AppState`` tenga datos del Excel.

        Returns:
            Lista de advertencias. Vacía si todo OK.
        """
        warnings: list[str] = []
        if not self._state.all_devices() and not self._state.dimensiones:
            warnings.append(
                "AppState está vacío. Cargue primero el Excel con "
                "'tia_sync_dispositivos_dimensions_from_excel'."
            )
        return warnings

    async def _read_plc_states(self, plc_name: str) -> dict[str, Any]:
        """Lee el estado actual del PLC vía gateway para N_MAX y todas
        las tablas de dispositivos configuradas.

        Returns:
            ``dict`` con:
              - ``nmax_current``: ``{valor_str: nombre}`` desde TIA N_MAX.
              - ``device_current``: ``{hw_type: {valor_str: nombre}}`` por tipo.
        """
        nmax_table = self._config.get_global_config_table_name()
        nmax_current = await self._gateway.get_user_constants(
            plc_name, nmax_table
        )

        device_current: dict[str, dict[str, str]] = {}
        for hw_type in self._config.list_hw_types():
            tag_table = self._config.get_tag_table_name(hw_type)
            if tag_table is None:
                continue
            current = await self._gateway.get_user_constants(plc_name, tag_table)
            device_current[hw_type] = current

        return {
            "nmax_current": nmax_current,
            "device_current": device_current,
        }

    def _build_nmax_desired_from_appstate(self) -> dict[str, int]:
        """Construye el ``desired_state`` de N_MAX desde ``AppState.dimensiones``.

        Returns:
            ``{nombre_constante: valor}`` para las N_MAX.
            Vacío si AppState no tiene dimensiones.
        """
        d = self._state.dimensiones
        # Usar ``getattr`` con default para tolerar campos faltantes.
        return {
            "N_MAX_DISP_ED":   int(getattr(d, "num_disp_ed",   0) or 0),
            "N_MAX_DISP_EA":   int(getattr(d, "num_disp_ea",   0) or 0),
            "N_MAX_DISP_SA":   int(getattr(d, "num_disp_sa",   0) or 0),
            "N_MAX_DISP_V":    int(getattr(d, "num_disp_v",    0) or 0),
            "N_MAX_DISP_M":    int(getattr(d, "num_disp_m",    0) or 0),
            "N_MAX_DISP_M_VF": int(getattr(d, "num_disp_m_vf", 0) or 0),
        }

    def _build_device_states_from_appstate(
        self,
        device_current: dict[str, dict[str, str]],
    ) -> dict[str, dict[str, dict[str, Any]]]:
        """Construye ``device_states_by_type`` desde ``AppState``.

        Args:
            device_current: ``{hw_type: {valor: nombre}}`` desde TIA.

        Returns:
            ``{hw_type: {"current": ..., "desired": ...}}``.
            Solo incluye tipos con datos en AppState.
        """
        states_by_type: dict[str, dict[str, dict[str, Any]]] = {}
        for hw_type, attr_name in _APP_STATE_ATTRS.items():
            devices = getattr(self._state, attr_name, [])
            if not devices:
                continue
            desired: dict[str, int] = {}
            for idx, device in enumerate(devices):
                # El VALOR (UID estable) es el índice + 1 (legacy convention).
                # El NOMBRE deseado es ``device.plc_tag`` o ``device.uid``.
                desired_value = idx + 1
                desired_name = (
                    str(getattr(device, "plc_tag", "") or "")
                    or str(getattr(device, "uid", "") or "")
                    or f"Disp_{hw_type.upper()}_{desired_value}"
                )
                desired[desired_name] = desired_value
            if desired:
                states_by_type[hw_type] = {
                    "current": device_current.get(hw_type, {}),
                    "desired": desired,
                }
        return states_by_type


__all__ = ["SyncConstantsFromExcelUseCase"]
