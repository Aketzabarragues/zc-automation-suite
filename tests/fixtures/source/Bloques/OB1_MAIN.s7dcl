{
    S7_BlockTitle := "MLC_3ck";
    S7_IECCheck := "TRUE";
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD";
    S7_Version := "0.1"
}
ORGANIZATION_BLOCK "OB1_MAIN"
    VAR_TEMP
        for_i : Int;
        t_HW_IOSYSTEM : HW_IOSYSTEM;
    END_VAR

    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_hY"
    }
    NETWORK
        RUNG wire#powerrail
            "FC50_MAIN"(
                CPU_MarcasCiclo := "Clock_Byte",
                CPU_MarcasSistema := "System_Byte"
            )
        END_RUNG
    END_NETWORK
END_ORGANIZATION_BLOCK
